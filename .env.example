KALSHI_API_KEY_ID=
KALSHI_API_PRIVATE_KEY_PEM=
KALSHI_API_PRIVATE_KEY_PEM_PATH=
KALSHI_API_BASE=https://api.elections.kalshi.com
KALSHI_API_VERSION=trade-api/v2
DUMMY_MODE=OFF
DUMMY_LOG_LEVEL=INFO
# Legacy aliases also accepted: DUMBY_MODE, DUMBY_LOG_LEVEL
GITHUB_TOKEN=
# Optional LLM provider credentials (mock fallback is used when absent).
# To use OpenRouter for both DeepSeek and Minimax, set the same key for
# DEEPSEEK_API_KEY and MINIMAX_API_KEY and ensure configs/model_routing.json
# points both providers at https://openrouter.ai/api/v1.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.chat
